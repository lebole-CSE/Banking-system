
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="900" prefHeight="650"
            style="-fx-background-color: #F2F5FA;">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-padding: 20;">

            <Label text="TRANSACTIONS"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #142D4E;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnTransactionBack"
                    text="Back to Dashboard"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets top="35" right="30"
                        bottom="30" left="30"/>
            </padding>

            <VBox spacing="18"
                  maxWidth="500"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 30;">

                <Label text="Make a Transaction"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #142D4E;"/>

                <Label text="Select Account"/>

                <ComboBox fx:id="cmbTransactionAccount"
                          promptText="Choose an account"
                          maxWidth="Infinity"/>

                <Label text="Transaction Type"/>

                <ComboBox fx:id="cmbTransactionType"
                          promptText="Select transaction type"
                          maxWidth="Infinity"/>

                <Label text="Amount (BWP)"/>

                <TextField fx:id="txtTransactionAmount"
                           promptText="Enter amount"
                           prefHeight="40"/>

                <Label fx:id="lblTransactionMessage"
                       text=""
                       wrapText="true"/>

                <HBox spacing="15">
                    <Button fx:id="btnMakeDeposit"
                            text="Deposit"
                            prefWidth="180"
                            prefHeight="42"
                            style="-fx-background-color: #16804A;
                                   -fx-text-fill: white;"/>

                    <Button fx:id="btnMakeWithdrawal"
                            text="Withdraw"
                            prefWidth="180"
                            prefHeight="42"
                            style="-fx-background-color: #B33A3A;
                                   -fx-text-fill: white;"/>
                </HBox>

                <Button fx:id="btnClearTransaction"
                        text="Clear"
                        maxWidth="Infinity"/>

            </VBox>
        </VBox>
    </center>
</BorderPane>
