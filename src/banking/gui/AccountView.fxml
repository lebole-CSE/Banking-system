<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.AccountController"
            prefWidth="1000" prefHeight="650"
            style="-fx-background-color: #F3F6FA;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #163B65; -fx-padding: 22;">
            <Label text="MY ACCOUNTS"
                   style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="22" style="-fx-padding: 35;">

            <Label text="Account Overview"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #163B65;"/>

            <GridPane hgap="15" vgap="15">
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                      spacing="8"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Account Number"/>
                    <Label fx:id="lblAccountNumber" text="-"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                      spacing="8"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Account Type"/>
                    <Label fx:id="lblAccountType" text="-"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0"
                      spacing="8"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Available Balance"/>
                    <Label fx:id="lblAccountBalance" text="BWP 0.00"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="3" GridPane.rowIndex="0"
                      spacing="8"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Branch"/>
                    <Label fx:id="lblAccountBranch" text="-"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
            </GridPane>

            <Label text="Your Accounts"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #163B65;"/>

            <TableView fx:id="tblAccounts" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Account Number" prefWidth="200"/>
                    <TableColumn text="Account Type" prefWidth="200"/>
                    <TableColumn text="Balance (BWP)" prefWidth="200"/>
                    <TableColumn text="Branch" prefWidth="200"/>
                </columns>
            </TableView>

            <HBox spacing="12">
                <Button text="Refresh"
                        onAction="#refreshAccounts"
                        prefWidth="120" prefHeight="40"/>

                <Button text="Deposit"
                        onAction="#deposit"
                        prefWidth="120" prefHeight="40"
                        style="-fx-background-color: #163B65; -fx-text-fill: white;"/>

                <Button text="Withdraw"
                        onAction="#withdraw"
                        prefWidth="120" prefHeight="40"
                        style="-fx-background-color: #D69E36; -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Back to Dashboard"
                        onAction="#backToDashboard"
                        prefWidth="170" prefHeight="40"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
