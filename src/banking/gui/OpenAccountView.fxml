<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.OpenAccountController"
            prefWidth="1000" prefHeight="700"
            style="-fx-background-color: #F3F6FA;">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #163B65; -fx-padding: 22;">
            <Label text="OPEN NEW ACCOUNT"
                   style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F3F6FA; -fx-background-color: #F3F6FA;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20"
                      style="-fx-padding: 30;">

                    <Label text="Customer Account Registration"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #163B65;"/>

                    <GridPane hgap="20" vgap="15"
                              maxWidth="750"
                              style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">

                        <Label text="First Name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtFirstName"
                                   promptText="Enter first name"
                                   prefHeight="40"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                        <Label text="Surname" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtSurname"
                                   promptText="Enter surname"
                                   prefHeight="40"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Customer ID" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtCustomerId"
                                   promptText="Enter customer ID"
                                   prefHeight="40"
                                   GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                        <Label text="Phone Number" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtPhoneNumber"
                                   promptText="Enter phone number"
                                   prefHeight="40"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Account Type" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <ComboBox fx:id="cmbAccountType"
                                  promptText="Select account type"
                                  prefWidth="300" prefHeight="40"
                                  GridPane.columnIndex="0" GridPane.rowIndex="5"/>

                        <Label text="Initial Deposit (BWP)" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <TextField fx:id="txtInitialDeposit"
                                   promptText="Enter initial deposit"
                                   prefHeight="40"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                        <Label text="Branch" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <TextField fx:id="txtBranch"
                                   promptText="Enter branch"
                                   prefHeight="40"
                                   GridPane.columnIndex="0" GridPane.rowIndex="7"/>

                        <Label text="Company Name (Cheque Account)" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                        <TextField fx:id="txtCompanyName"
                                   promptText="Enter company name"
                                   prefHeight="40"
                                   GridPane.columnIndex="0" GridPane.rowIndex="9"/>

                        <Label text="Company Address (Cheque Account)" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                        <TextField fx:id="txtCompanyAddress"
                                   promptText="Enter company address"
                                   prefHeight="40"
                                   GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                        <Label fx:id="lblAccountMessage"
                               wrapText="true"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="10"
                               GridPane.columnSpan="2"
                               style="-fx-text-fill: #163B65;"/>

                        <HBox spacing="15"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="11"
                              GridPane.columnSpan="2">

                            <Button text="CREATE ACCOUNT"
                                    onAction="#createAccount"
                                    prefWidth="200" prefHeight="43"
                                    style="-fx-background-color: #163B65; -fx-text-fill: white; -fx-font-weight: bold;"/>

                            <Button text="CLEAR"
                                    onAction="#clearAccount"
                                    prefWidth="120" prefHeight="43"/>

                            <Button text="BACK"
                                    onAction="#backToDashboard"
                                    prefWidth="120" prefHeight="43"/>

                        </HBox>

                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
